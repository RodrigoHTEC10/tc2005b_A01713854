<%- include('./includes/header.ejs') %>

<% if (success.length > 0) { %>
    <div class="notification block is-flex is-justify-content-center" style="border: 2px solid green;">
        <button class="delete"></button>
        <%= success[0] %>
    </div>
<% } %>
<% if(username == "") { %>
    <div class="notification block is-flex is-justify-content-center" style="border: 2px solid red;">
        <button class="delete"></button>
        El usuario ha salido correctamente.
    </div>
<% } %>

<% let create_musical = false; %>
<% let create_question = false; %>

<% for(let priv of privileges){ %>
    <% console.log(priv.name); %>
    <% if(priv.name == 'create-musical') {%>
        <% create_musical=true; %>
    <% } %> 
    <% if(priv.name == 'create-question') {%>
        <% create_question=true; %>       
    <% } %>
<% } %>


<% if(create_musical && create_question){ %>
    <%- include('./includes/both_buttons.ejs') %>
<% } else if(create_musical){ %>
    <%- include('./includes/button_form_musical.ejs') %>
<% } else if(create_question){ %>
    <%- include('./includes/button_form_question.ejs') %>
<% } %>

<%- include('./includes/interest.ejs') %>
<%- include('./includes/abilities.ejs') %>

<%- include('./includes/musicals.ejs') %>
<%- include('./includes/questions.ejs') %>

<%- include('./includes/footer.ejs') %>