
<% if(error != '') { %>
<div class="notification block is-flex is-justify-content-center" style="border: 2px solid red;">
    <button class="delete"></button>
    <%= error %>
</div>
<% } %>

<div class="block is-flex is-justify-content-center">

    <form action="/users/login" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" >
        <div class="field">
            <label for="username" class="label">Username</label>
            <div class="control">
            <input id="username" name="username" class="input" type="text" placeholder="e.g juanHernandez@gmail.com" required>
            </div>
        </div>

        <div class="field">
            <label for="password" class="label">Password</label>
            <div class="control">
            <input id="password" name="password" class="input" type="password" placeholder="e.g. Contraseña" required>
            </div>
        </div>

        <input class="button is-primary" type="submit" value="Save & Sent">
    </form>
</div>