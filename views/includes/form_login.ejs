
<% if(error != '') { %>
<div class="notification block is-flex is-justify-content-center" style="border: 2px solid red;">
    <button class="delete"></button>
    <%= error %>
</div>
<% } %>

<div class="block is-flex is-justify-content-center">
    <form action="/users/login" method="POST">
        
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" >
        
        <div class="field">
            <div class="control has-icons-left">
                <input id="username" name="username" class="input" type="text" placeholder="Username" required>
                <span class="icon is-small is-left">
                    <i class="fa-solid fa-circle-user"></i>
                </span>
            </div>
        </div>

        <div class="field">
            <div class="control has-icons-left">
                <input id="password" name="password" class="input" type="password" placeholder="Password" required>
                <span class="icon is-small is-left">
                    <i class="fa-solid fa-key"></i>
                </span>
            </div>
        </div>

        <div class="field is-grouped is-grouped-centered">
            <input class="button is-light" type="submit" value="Login">
        </div>
        
    </form>
</div>