<%
const alt_text_data = typeof alt_text !== 'undefined' && alt_text
? alt_text
: null;
%>

<!--Answers to Questions from Lab. 01-->
    <section class="section">
        <div class="container content">
            <h2 class="subtitle has-text-centered">Preguntas <%= title %></h2>

            <% if(alt_text_data) { %>
            <div class="notification block is-flex is-justify-content-center" style="border: 2px solid red;">
                <button class="delete"></button>
                <%= alt_text_data %>
            </div>
            <% } %>

                <% for(let i = 0; i<questions.length; i++){ %>
                <article class="block">
                    <header>
                        <strong>
                            <a href="/questions/id/<%= questions[i].question_id%>"><%= questions[i].question %></a> 
                        </strong> <code><%= questions[i].label %></code>

                        <% for(let priv of privileges){ %>
                            <% if(priv.name == 'create-question') {%>
                                <div class="field has-addons">
                                    <p class="control">
                                        <a href="/questions/edit/<%= questions[i].question_id %>">
                                        <button class="button">
                                            <span class="icon is-small">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </span>
                                        </button>
                                        </a>
                                    </p>
                                    <p class="control">
                                        <button class="button confirm-deletion" data-id="<%= questions[i].question_id %>">
                                            <span class="icon is-small">
                                                <i class="fa-solid fa-trash"></i>
                                            </span>
                                        </button>
                                    </p>
                                </div>
                            <% } %>
                        <% } %>
                                
                    </header>

                    <div class="content">
                    <%- questions[i].answer %>
                    </div>
                </article>
                <br>
                <% } %>
        </div>


    <div id="deleteModal" class="modal">
        <div class="modal-background"></div>

        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title">Confirmar eliminación</p>
            </header>

            <section class="modal-card-body">
            ¿Seguro que quieres eliminar esta pregunta?
            </section>

            <footer class="modal-card-foot">
            <button id="confirmDelete" class="button is-danger">
                Eliminar
            </button>
            <button class="button close-modal">
                Cancelar
            </button>
            </footer>
        </div>
    </div>


    </section>

<script>
    const modal = document.getElementById('deleteModal');

    document.querySelectorAll(".confirm-deletion").forEach(button => {
        button.addEventListener("click", function(){
            console.log("I have heard you");
            const questionId = this.dataset.id;
            showDeletePopup(questionId);
        });
    });

    document.querySelectorAll(".close-modal").forEach(button => {
        button.addEventListener("click", function() {
            modal.classList.remove('is-active');
        });
    });

    function showDeletePopup(questionId){
        modal.classList.add('is-active');
        const confirmation = document.getElementById('confirmDelete');
        confirmation.onclick = ()=> {
            window.location.href = `/questions/delete/${questionId}`;
        };
    };

</script>