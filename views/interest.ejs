<%- include('./includes/header.ejs') %>

<!-- * Dinamic Appearance of Buttons based on privileges-->
<% let create_musical = false; %>
<% let create_question = false; %>

<% for(let priv of privileges){ %>
    <% if(priv.name == 'create-musical') {%>
        <% create_musical=true; %>
    <% } %> 
    <% if(priv.name == 'create-question') {%>
        <% create_question=true; %>       
    <% } %>
<% } %>


<% if(create_musical && create_question){ %>
    <%- include('./includes/both_buttons.ejs') %>
<% } else if(create_musical){ %>
    <%- include('./includes/button_form_musical.ejs') %>
<% } else if(create_question){ %>
    <%- include('./includes/button_form_question.ejs') %>
<% } %>


<%- include('./includes/interest.ejs') %>
<%- include('./includes/footer.ejs') %>